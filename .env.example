# AifyCycle Environment Configuration
# Copy this file to .env and configure your keys.

# 1. Google Gemini API (Required for AI Coach & Cycle Syncing)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# 2. Supabase Integration (Optional - enables cloud sync, multi-device backup, and partner sharing)
# Get free project credentials at: https://supabase.com/dashboard
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
# Server-side only (NEVER expose to browser): enables Admin Panel user directory, DB integrity, & telemetry persistence
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 3. Admin Panel Access (/admin) - Hybrid Auth
# Comma-separated allowlisted admin emails for Supabase Auth sign-in
ADMIN_EMAILS=admin@example.com
# Optional emergency / local Admin Secret Key fallback (use a strong random string in production)
ADMIN_SECRET=change_me_to_a_strong_admin_secret

# 4. Server Configuration
PORT=4180
HOST=0.0.0.0
