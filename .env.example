# AifyCycle Environment Configuration
# Copy this file to .env and configure your keys.

# 1. Google Gemini API (Required for AI Coach & Cycle Syncing)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# 2. Supabase Integration (Optional - enables cloud sync, multi-device backup, and partner sharing)
# Get free project credentials at: https://supabase.com/dashboard
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# 3. Server Configuration
PORT=4180
HOST=0.0.0.0
